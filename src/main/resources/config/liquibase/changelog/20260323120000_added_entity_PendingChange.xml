<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260323120000-1" author="gotechly">
        <createTable tableName="pending_change">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="change_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="bigint"/>
            <column name="payload" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="previous_value" type="clob"/>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)"/>
            <column name="maker_username" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="maker_date" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="checker_username" type="varchar(200)"/>
            <column name="checker_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="checker_remarks" type="varchar(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="20260323120000-2" author="gotechly">
        <createIndex tableName="pending_change" indexName="idx_pending_change_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="pending_change" indexName="idx_pending_change_entity_type">
            <column name="entity_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
