<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260602100000-1" author="gotechly">
        <createTable tableName="template_lookup">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="template_name" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tmp_lookup_tmp_name"/>
            </column>
            <column name="content_type" type="varchar(60)">
                <constraints nullable="true"/>
            </column>
            <column name="req_template" type="CLOB">
                <constraints nullable="true"/>
            </column>
            <column name="url" type="varchar(200)">
                <constraints nullable="true"/>
            </column>
            <column name="additional_header_1" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="additional_header_2" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="status_exp" type="varchar(300)">
                <constraints nullable="true"/>
            </column>
            <column name="tran_id_exp" type="varchar(300)">
                <constraints nullable="true"/>
            </column>
            <column name="error_exp" type="varchar(300)">
                <constraints nullable="true"/>
            </column>
            <column name="time_out_exp" type="varchar(300)">
                <constraints nullable="true"/>
            </column>
            <column name="provider_code" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="param_1" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="param_2" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="modified_by" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="modify_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="hm" type="varchar(200)">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex indexName="idx_tmpt_lookup_p_code" tableName="template_lookup">
            <column name="provider_code"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
