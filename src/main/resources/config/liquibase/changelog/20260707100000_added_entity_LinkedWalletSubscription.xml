<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260707100000-1" author="gotechly">
        <createTable tableName="linked_wallet_subscription">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_type" type="varchar(100)"><constraints nullable="true"/></column>
            <column name="psp_name" type="varchar(100)"><constraints nullable="true"/></column>
            <column name="mobile_phonenumber" type="varchar(15)"><constraints nullable="true"/></column>
            <column name="savings_accountnumber" type="varchar(16)"><constraints nullable="true"/></column>
            <column name="operating_currency_code" type="varchar(16)"><constraints nullable="true"/></column>
            <column name="firstname" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="middlename" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="lastname" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="dateofbirth" type="date"><constraints nullable="true"/></column>
            <column name="nationalid" type="varchar(20)"><constraints nullable="true"/></column>
            <column name="passport_number" type="varchar(50)"><constraints nullable="true"/></column>
            <column name="country_code" type="varchar(3)"><constraints nullable="true"/></column>
            <column name="city_town" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="address1" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="address2" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="postalcode" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="postal_address" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="opening_date" type="date"><constraints nullable="true"/></column>
            <column name="agent_number" type="varchar(50)"><constraints nullable="true"/></column>
            <column name="agent_name" type="varchar(80)"><constraints nullable="true"/></column>
            <column name="bank_name" type="varchar(100)"><constraints nullable="true"/></column>
            <column name="bank_shortcode" type="varchar(50)"><constraints nullable="true"/></column>
            <column name="reference_number" type="varchar(100)"><constraints nullable="true"/></column>
            <column name="action_code" type="varchar(6)"><constraints nullable="true"/></column>
            <column name="status" type="int"><constraints nullable="true"/></column>
            <column name="remarks" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="psp_dob" type="varchar(10)"><constraints nullable="true"/></column>
            <column name="psp_national_id" type="varchar(15)"><constraints nullable="true"/></column>
            <column name="psp_phone" type="varchar(15)"><constraints nullable="true"/></column>
            <column name="create_date" type="date"><constraints nullable="true"/></column>
            <column name="link_status" type="varchar(10)"><constraints nullable="true"/></column>
            <column name="link_tran_id" type="varchar(10)"><constraints nullable="true"/></column>
            <column name="vmtref_id" type="bigint"><constraints nullable="true"/></column>
            <column name="vmtref" type="varchar(50)"><constraints nullable="true"/></column>
            <column name="credit_qualified" type="varchar(10)"><constraints nullable="true"/></column>
            <column name="loan_account" type="varchar(50)"><constraints nullable="true"/></column>
            <column name="loan_balance" type="decimal(21,2)"><constraints nullable="true"/></column>
            <column name="hash1" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="hash2" type="varchar(200)"><constraints nullable="true"/></column>
            <column name="additional_fields" type="clob"><constraints nullable="true"/></column>
        </createTable>

        <createIndex indexName="idx_lw_sub_acct" tableName="linked_wallet_subscription">
            <column name="savings_accountnumber"/>
        </createIndex>
        <createIndex indexName="idx_lw_sub_mobile" tableName="linked_wallet_subscription">
            <column name="mobile_phonenumber"/>
        </createIndex>
        <createIndex indexName="idx_lw_sub_vmtref" tableName="linked_wallet_subscription">
            <column name="vmtref"/>
        </createIndex>
        <createIndex indexName="idx_lw_sub_psp_name" tableName="linked_wallet_subscription">
            <column name="psp_name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
