<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="20260216143000-1" author="gotechly">
        <createTable tableName="app_configs">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="config_id" type="varchar(200)">
                <constraints nullable="true" />
            </column>
            <column name="config_value" type="varchar(3000)">
                <constraints nullable="true" />
            </column>
            <column name="service_type" type="varchar(200)">
                <constraints nullable="true" />
            </column>
            <column name="config_status" type="varchar(100)">
                <constraints nullable="true" />
            </column>
            <column name="config_bin_value" type="blob">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
