<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260420100000-1" author="gotechly">
        <createTable tableName="history_audit_log">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_type" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_name" type="varchar(100)"/>
            <column name="phase_name" type="varchar(100)"/>
            <column name="old_value" type="clob"/>
            <column name="new_value" type="clob"/>
            <column name="changed_fields" type="clob"/>
            <column name="actor_id" type="varchar(100)"/>
            <column name="actor_type" type="varchar(50)"/>
            <column name="actor_username" type="varchar(100)"/>
            <column name="role" type="varchar(100)"/>
            <column name="ip_address" type="varchar(50)"/>
            <column name="user_agent" type="varchar(200)"/>
            <column name="session_id" type="varchar(100)"/>
            <column name="request_id" type="varchar(200)"/>
            <column name="endpoint" type="varchar(300)"/>
            <column name="http_method" type="varchar(10)"/>
            <column name="environment" type="varchar(20)"/>
            <column name="service_name" type="varchar(200)"/>
            <column name="created_at"  type="TIMESTAMP WITH TIME ZONE"  defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
